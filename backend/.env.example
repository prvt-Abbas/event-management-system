# Copy this file to .env and fill in your own MySQL details
# cp .env.example .env   (on Windows: copy .env.example .env)

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=ali@12345
DB_NAME=event_db
DB_PORT=3306
# Change DB_PORT to 3306 ONLY if your MySQL actually runs on 3306.
# Backend, setup and check all read this one file, so this value must be right.
PORT=5000
